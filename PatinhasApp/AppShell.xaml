<?xml version="1.0" encoding="UTF-8" ?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:views="clr-namespace:PatinhasApp.Views"
       x:Class="PatinhasApp.AppShell"
       Title="Patinhas do Bem"
       FlyoutBehavior="Disabled">

    <!-- Abas fixas na parte de baixo da tela -->
    <TabBar>
        <ShellContent Title="Cães"
                      Route="caes"
                      ContentTemplate="{DataTemplate views:CaesPage}" />
        <ShellContent Title="Adoções"
                      Route="adocoes"
                      ContentTemplate="{DataTemplate views:AdocoesPage}" />
        <ShellContent Title="Alertas"
                      Route="alertas"
                      ContentTemplate="{DataTemplate views:AlertasPage}" />
        <ShellContent Title="Ajustes"
                      Route="ajustes"
                      ContentTemplate="{DataTemplate views:AjustesPage}" />
    </TabBar>
</Shell>
