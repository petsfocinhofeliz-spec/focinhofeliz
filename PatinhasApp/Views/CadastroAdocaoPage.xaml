<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:PatinhasApp.ViewModels"
             x:Class="PatinhasApp.Views.CadastroAdocaoPage"
             x:DataType="vm:CadastroAdocaoViewModel"
             Title="{Binding Titulo}">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="6">

            <Label Text="Cão adotado" Style="{StaticResource Rotulo}" />
            <Picker ItemsSource="{Binding Caes}"
                    ItemDisplayBinding="{Binding Nome}"
                    SelectedItem="{Binding CaoSelecionado}"
                    Title="Escolha o cão" />

            <Label Text="Data da adoção" Style="{StaticResource Rotulo}" />
            <DatePicker Date="{Binding DataAdocao}" Format="dd/MM/yyyy" />

            <Label Text="Nome do adotante" Style="{StaticResource Rotulo}" />
            <Entry Text="{Binding NomeAdotante}" Placeholder="Nome completo" />

            <Label Text="Contato" Style="{StaticResource Rotulo}" />
            <Entry Text="{Binding Contato}"
                   Placeholder="Telefone, WhatsApp ou e-mail"
                   Keyboard="Telephone" />

            <Label Text="Observações" Style="{StaticResource Rotulo}" />
            <Editor Text="{Binding Observacoes}"
                    Placeholder="Detalhes da adoção (opcional)"
                    AutoSize="TextChanges"
                    HeightRequest="90" />

            <Label Text="Ao salvar, o cão passa automaticamente para a situação &quot;Adotado&quot;."
                   Style="{StaticResource TextoSecundario}"
                   Margin="0,6,0,0" />

            <Button Text="Salvar adoção"
                    Style="{StaticResource BotaoPrimario}"
                    Command="{Binding SalvarCommand}"
                    Margin="0,10,0,0" />

            <Button Text="Cancelar"
                    Style="{StaticResource BotaoSecundario}"
                    Command="{Binding CancelarCommand}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
