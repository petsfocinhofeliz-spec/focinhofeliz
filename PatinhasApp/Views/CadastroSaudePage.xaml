<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:PatinhasApp.ViewModels"
             x:Class="PatinhasApp.Views.CadastroSaudePage"
             x:DataType="vm:CadastroSaudeViewModel"
             Title="{Binding Titulo}">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="6">

            <Label Text="Tipo" Style="{StaticResource Rotulo}" />
            <Picker ItemsSource="{Binding OpcoesTipo}"
                    SelectedIndex="{Binding TipoSelecionado}" />

            <Label Text="Descrição" Style="{StaticResource Rotulo}" />
            <Entry Text="{Binding Descricao}" Placeholder="Ex.: V10, Antirrábica, Cinomose" />

            <Label Text="Data" Style="{StaticResource Rotulo}" />
            <DatePicker Date="{Binding Data}" Format="dd/MM/yyyy" />

            <!-- Liga/desliga a próxima data prevista -->
            <Grid ColumnDefinitions="*,Auto" Margin="0,10,0,0">
                <Label Grid.Column="0" Text="Tem próxima data prevista?"
                       VerticalOptions="Center"
                       TextColor="{StaticResource TextoPrimario}" />
                <Switch Grid.Column="1"
                        IsToggled="{Binding TemProximaData}"
                        OnColor="{StaticResource Primary}" />
            </Grid>

            <!-- Só aparece quando o switch está ligado -->
            <StackLayout IsVisible="{Binding TemProximaData}" Spacing="6">
                <Label Text="Próxima data prevista" Style="{StaticResource Rotulo}" />
                <DatePicker Date="{Binding ProximaData}" Format="dd/MM/yyyy" />
                <Label Text="Usada nos alertas para avisar quando estiver perto de vencer."
                       Style="{StaticResource TextoSecundario}" />
            </StackLayout>

            <Label Text="Observações" Style="{StaticResource Rotulo}" />
            <Editor Text="{Binding Observacoes}"
                    Placeholder="Detalhes do registro (opcional)"
                    AutoSize="TextChanges"
                    HeightRequest="90" />

            <Button Text="Salvar"
                    Style="{StaticResource BotaoPrimario}"
                    Command="{Binding SalvarCommand}"
                    Margin="0,16,0,0" />

            <Button Text="Cancelar"
                    Style="{StaticResource BotaoSecundario}"
                    Command="{Binding CancelarCommand}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
